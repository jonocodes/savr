{
  "manifest_version": 3,
  "name": "Savr",
  "version": "0.1.2",
  "description": "Save the page you are reading to Savr, without re-downloading it.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "https://savr.link/*", "*://*/*"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Savr",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "savr@jonocodes.github.io",
      "strict_min_version": "142.0",
      "update_url": "https://savr.link/extension/updates.json",
      "data_collection_permissions": {
        "required": ["websiteContent", "browsingActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
